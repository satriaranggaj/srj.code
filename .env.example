APP_NAME="SRJ Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=srj_portfolio
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# Uploaded thumbnails and logos are written to the `public` disk, which is served
# from /storage. Run `php artisan storage:link` after installing.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set to true on an HTTPS deployment so the session cookie is never sent over
# plain HTTP. Leave unset while developing over HTTP.
SESSION_SECURE_COOKIE=

# Optional portfolio contact channels. Disabled by default so an unverified
# address or profile URL is never rendered on the public site.
# See config/portfolio.php for every channel and its enabled flag.
PORTFOLIO_EMAIL=
PORTFOLIO_RESUME_URL=
PORTFOLIO_TWITTER_SITE=

# Self-registration is closed. Every authenticated account can edit all
# portfolio content, so only set this to true while creating an extra admin.
ALLOW_REGISTRATION=false

VITE_APP_NAME="${APP_NAME}"